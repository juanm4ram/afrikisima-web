# Copiá este archivo a `.env.local`. Ninguna de estas variables es obligatoria
# para correr el MVP: sin ellas la tienda usa el catálogo local.

# --- Afrikísima -----------------------------------------------------------
# WhatsApp del negocio, formato internacional sin "+" ni espacios.
NEXT_PUBLIC_WHATSAPP_NUMBER=5492915000000
NEXT_PUBLIC_INSTAGRAM=afrikisima
NEXT_PUBLIC_CONTACT_EMAIL=hola@afrikisima.com
# URL pública (para las imágenes de Open Graph al compartir el link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Storefront externo (opcional, heredado del starter) -------------------
# Si algún día se conecta un backend de productos/pagos, se configura acá.
# NEXT_PUBLIC_CRAVEUP_API_KEY=
# NEXT_PUBLIC_LOCATION_ID=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
