# Copiá este archivo a `.env.local` y completá los valores.
# `.env.local` está en el .gitignore: nunca se sube al repositorio.

# --- Contacto (obligatorio en producción) ---------------------------------
# Sin estas dos, el sitio arranca con datos de ejemplo y los pedidos NO llegan.
# WhatsApp en formato internacional, sin "+" ni espacios.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Redes y metadatos (opcionales) ---------------------------------------
NEXT_PUBLIC_INSTAGRAM=afrikisima_
NEXT_PUBLIC_TIKTOK=afrikisima
# URL pública, para la miniatura al compartir el link
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Storefront externo (opcional, heredado del starter) -------------------
# Si algún día se conecta un backend de productos/pagos, se configura acá.
# NEXT_PUBLIC_CRAVEUP_API_KEY=
# NEXT_PUBLIC_LOCATION_ID=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
